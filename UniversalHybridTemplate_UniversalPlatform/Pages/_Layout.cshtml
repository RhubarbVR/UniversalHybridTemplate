@using Microsoft.AspNetCore.Components.Web
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="~/" />
 
	<link rel="preload" href="_content/UniversalHybridTemplate_Shared/css/app.css" as="style" />
	<link rel="stylesheet" href="_content/UniversalHybridTemplate_Shared/css/app.css" />

	<link href="UniversalHybridTemplate.styles.css" rel="stylesheet" />

	<link rel="manifest" href="_content/UniversalHybridTemplate_Shared/manifest.json" />
	<link rel="icon" type="image/png" href="_content/UniversalHybridTemplate_Shared/favicon.png" />

	<component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
	<script src="_content/Microsoft.FluentUI.AspNetCore.Components/js/loading-theme.js" type="text/javascript"></script>
	<loading-theme storage-name="theme"></loading-theme>

	@RenderBody()

	<div id="blazor-error-ui">
		An unhandled error has occurred.
		<a href="" class="reload">Reload</a>
		<a class="dismiss">🗙</a>
	</div>

	<script src="_framework/blazor.server.js"></script>
</body>
</html>
